<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <!-- 2026-07-12: DUAL-LINK transport config. Ethernet via JioAirFiber
             switch (eth0 192.168.2.10 <-> Jetson enP8p1s0 192.168.2.20).
             Discovery handled by the local DS server (ROS_DISCOVERY_SERVER=
             127.0.0.1:11811 in run_brain/run_microros scripts). This file
             only controls transport: both eth0 and wlan0 whitelisted. -->
        <transport_id>dual_link</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>192.168.2.10</address>
          <address>192.168.1.16</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="unicast_profile" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>dual_link</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
