# ROS 2 build artifacts
build/
install/
log/

# IDE files
.idea/
.vscode/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# LangGraph Studio
.env
# Dated backups of .env hold the same live keys the rule above protects
# (a `cp .env .env.bak.$(date +%F)` before editing is a habit worth keeping —
# committing the result is not).
.env.bak*
.env.*.bak
# LibreOffice/OpenOffice edit locks left next to the hardware docs
.~lock.*#
.langgraph_api/

# Other
.DS_Store
.pytest_cache/

# Voice model weights (downloaded, not tracked — see langrobo_ros/models/README.md)
src/langrobo_ros/models/**/*.onnx
src/langrobo_ros/models/**/*.bin
src/langrobo_ros/models/whisper/
