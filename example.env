# LangRobo .env — copy to .env and fill in as keys become available.
# Loaded by agent_node (LANGROBO_ENV_FILE overrides the ~/ros2_ws/.env default)
# and by graph_studio.py. Validated at startup by langrobo_core.services.config:
# malformed values fail fast; missing optional keys just disable that feature.
# LLM provider/model/slots live in src/langrobo_ros/config/agent_params.yaml.

# ── Security ──────────────────────────────────────────────────────────────────
# Bearer token for the health API (/status, /metrics). Generate one:
#   openssl rand -hex 24
# Empty → the API binds to 127.0.0.1 only (a LAN bind without a token is refused).
LANGROBO_API_TOKEN=

# ── Health API ────────────────────────────────────────────────────────────────
#LANGROBO_HEALTH=true
#LANGROBO_HEALTH_PORT=8090
#LANGROBO_HEALTH_HOST=0.0.0.0        # requires LANGROBO_API_TOKEN

# ── Cloud LLM fallback (local-first: used only when the Mac Mini is down) ─────
# Arms automatically once the named key exists in this file.
#LANGROBO_FALLBACK_PROVIDER=anthropic     # openai | anthropic | gemini
#LANGROBO_FALLBACK_MODEL=claude-haiku-4-5-20251001
#LANGROBO_FALLBACK_API_KEY_ENV=ANTHROPIC_API_KEY

# ── Episodic memory (Qdrant) ──────────────────────────────────────────────────
# Default: embedded local store, zero infra. Set QDRANT_URL to use a server /
# Qdrant Cloud instead (config-only swap).
#LANGROBO_MEMORY=true
#LANGROBO_MEMORY_PATH=~/.langrobo/qdrant
#QDRANT_URL=
#QDRANT_API_KEY=

# ── Home watch mode ───────────────────────────────────────────────────────────
# "Watch the house" (voice or Telegram) arms it; a person seen on camera then
# sends a photo to every owner-role Telegram member. Armed state survives
# restarts (~/.langrobo/watch.json). Alerts bypass quiet hours on purpose.
#LANGROBO_WATCH=true
#LANGROBO_WATCH_COOLDOWN_S=60        # min seconds between alerts
#LANGROBO_WATCH_MIN_CONF=0.5         # ignore person detections below this confidence

# ── Nightly memory consolidation ("self-learning") ────────────────────────────
# Distills recent episodic turns into durable household facts, locally, on the
# Mac Mini model — never the cloud. Runs once per day at/after this hour, only
# while the robot is idle. State: ~/.langrobo/consolidation.json.
#LANGROBO_CONSOLIDATION=true
#LANGROBO_CONSOLIDATION_HOUR=3

# ── Morning briefing (briefing agent) ─────────────────────────────────────────
# Opt-in: setting the hour enables a once-daily spoken briefing (reminders,
# weather via Tavily if configured, list highlights). Unset = off.
#LANGROBO_BRIEFING_HOUR=8

# ── Logging / tracing ─────────────────────────────────────────────────────────
#LANGROBO_LOG_JSON=true
# LangSmith tracing is OFF unless explicitly opted in (stale keys otherwise
# spam 403s on every LLM call):
#LANGROBO_TRACING=true
#LANGSMITH_API_KEY=

# ── Cloud provider API keys (referenced by name from configs above) ───────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Feature keys (absent → feature cleanly disabled) ──────────────────────────
# Swiggy (food + instamart + dineout): log in with scripts/swiggy_login.py —
# the token lands in ~/.langrobo/mcp_tokens.json (~5-day life, the robot nudges
# you over Telegram when it expires). SWIGGY_ACCESS_TOKEN is a legacy override
# that beats the token file when set.
SWIGGY_ACCESS_TOKEN=
#LANGROBO_MCP_TOKENS=~/.langrobo/mcp_tokens.json
#SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
#SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
#SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout
TAVILY_API_KEY=

# ── Telegram channel ──────────────────────────────────────────────────────────
# Bot token from @BotFather. The channel stays OFF unless BOTH the token and a
# non-empty allowlist are set — the bot never talks to strangers.
# Allowlist: chat_id:Name:role (comma-separated). Roles: owner | family | guest
# (capability sets in langrobo_core/services/permissions.py). Get your chat_id
# by messaging @userinfobot on Telegram.
LANGROBO_TELEGRAM_TOKEN=
#LANGROBO_TELEGRAM_ALLOWLIST=123456789:Rakesh:owner,987654321:Mom:family
# Proactive pings (reminder/delivery events) queue during this window and send
# after it; replies to direct messages always go through. Overnight wrap OK.
#LANGROBO_QUIET_HOURS=23:00-07:00

# ── LangGraph Studio (langgraph dev only) ─────────────────────────────────────
STUDIO_PROVIDER=llamacpp
STUDIO_MODEL=default
STUDIO_BASE_URL=http://singireddys-mac-mini.local:8080/v1
STUDIO_MAX_TOKENS=3000

# ── ROS2 (must match the Jetson) ──────────────────────────────────────────────
ROS_DOMAIN_ID=0
