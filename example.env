# ── LLM Provider ─────────────────────────────────────────────────────────────
# Provider: llamacpp | openai | anthropic | gemini | ollama
# Set in agent_params.yaml or as launch arguments — NOT env vars.
# These are here for reference only.
#
#   provider=llamacpp   base_url=http://192.168.31.24:8080/v1   (local llama.cpp)
#   provider=ollama     base_url=http://localhost:11434
#   provider=openai     model=gpt-4o
#   provider=anthropic  model=claude-sonnet-4-6
#   provider=gemini     model=gemini-1.5-flash

# ── API Keys (only needed for cloud providers) ────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Set the env var name in agent_params.yaml under api_key_env:
#   api_key_env: "OPENAI_API_KEY"

# ── Swiggy Food MCP ───────────────────────────────────────────────────────────
# URL of the Swiggy MCP server. Defaults to https://mcp.swiggy.com/food
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food

# Bearer token for Swiggy authentication (leave empty if not required)
SWIGGY_ACCESS_TOKEN=

# ── Tavily Web Search (optional) ──────────────────────────────────────────────
# Get a free key at https://tavily.com — enables web search in the chat agent.
# If not set, web search is silently disabled.
TAVILY_API_KEY=tvly-...

# ── ROS2 Domain (optional) ────────────────────────────────────────────────────
# Must match on Pi5 and Jetson for DDS discovery to work.
ROS_DOMAIN_ID=0
