# LangRobo .env — copy to .env and fill in as keys become available.
# Loaded by agent_node (LANGROBO_ENV_FILE overrides the ~/ros2_ws/.env default)
# and by graph_studio.py. Validated at startup by langrobo_core.services.config:
# malformed values fail fast; missing optional keys just disable that feature.
# LLM provider/model live in src/langrobo_ros/config/agent_params.yaml; each
# agent's llama.cpp KV slot lives in langrobo_core/registry.py, beside the agent.

# ── Security ──────────────────────────────────────────────────────────────────
# Bearer token for the health API (/status, /metrics). Generate one:
#   openssl rand -hex 24
# Empty → the API binds to 127.0.0.1 only (a LAN bind without a token is refused).
LANGROBO_API_TOKEN=

# ── Health API ────────────────────────────────────────────────────────────────
#LANGROBO_HEALTH=true
#LANGROBO_HEALTH_PORT=8090
#LANGROBO_HEALTH_HOST=0.0.0.0        # requires LANGROBO_API_TOKEN

# ── Cloud LLM fallback (local-first: used only when the Mac Mini is down) ─────
# Arms automatically once the named key exists in this file.
#LANGROBO_FALLBACK_PROVIDER=anthropic     # openai | anthropic | gemini
#LANGROBO_FALLBACK_MODEL=claude-haiku-4-5-20251001
#LANGROBO_FALLBACK_API_KEY_ENV=ANTHROPIC_API_KEY

# ── Logging / tracing ─────────────────────────────────────────────────────────
#LANGROBO_LOG_JSON=true
# LangSmith tracing is OFF unless explicitly opted in (stale keys otherwise
# spam 403s on every LLM call):
#LANGROBO_TRACING=true
#LANGSMITH_API_KEY=

# ── Cloud provider API keys (referenced by name from configs above) ───────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Feature keys (absent → feature cleanly disabled) ──────────────────────────
# Web search for chat. Without it chat answers from its own knowledge and says
# honestly that it cannot look something up.
TAVILY_API_KEY=

# ── Telegram channel ──────────────────────────────────────────────────────────
# Bot token from @BotFather. The channel stays OFF unless BOTH the token and a
# non-empty allowlist are set — the bot never talks to strangers.
# Allowlist: chat_id:Name:role (comma-separated). Roles: owner | family | guest
# (capability sets in langrobo_core/services/permissions.py). Get your chat_id
# by messaging @userinfobot on Telegram.
LANGROBO_TELEGRAM_TOKEN=
#LANGROBO_TELEGRAM_ALLOWLIST=123456789:Rakesh:owner,987654321:Mom:family
# Proactive pings (reminder/delivery events) queue during this window and send
# after it; replies to direct messages always go through. Overnight wrap OK.
#LANGROBO_QUIET_HOURS=23:00-07:00

# ── pi5_voice_pkg cloud STT (opt-in — stt_provider defaults to "local") ───────
# Set stt_provider: sarvam|soniox in pi5_voice_pkg/config/voice_params.yaml to
# use one of these; a missing key here (or any request failure) falls back to
# local faster-whisper automatically, it never goes silent. PI5_VOICE.md has
# the cost/latency comparison that picked between them.
SARVAM_API_KEY=
SONIOX_API_KEY=

# ── LangGraph Studio (langgraph dev only) ─────────────────────────────────────
STUDIO_PROVIDER=llamacpp
STUDIO_MODEL=default
STUDIO_BASE_URL=http://singireddys-mac-mini.local:8080/v1
STUDIO_MAX_TOKENS=3000

# ── ROS2 (must match the Jetson) ──────────────────────────────────────────────
ROS_DOMAIN_ID=0

# ── Robot behaviour (all optional; defaults suit this rover) ──────────────────
# The frame goals, TF pose reads and detections all agree on. This rover runs
# Nav2 single-session in odom and has no map frame at all.
#LANGROBO_NAV_FRAME=odom
# How far short of an object approach_described_object parks, in metres. The
# Jetson's phase4/nodes/pixel_to_goal.py reads the SAME variable — export it on
# BOTH machines or the two halves of the approach disagree.
#LANGROBO_STANDOFF_M=0.45
# Set to 1 only once pan/tilt servos are physically fitted AND the ESP32
# firmware subscribes to /servo_pan + /servo_tilt. Off by default because it
# does neither today, and the sweep it enables costs ~5s per search.
#LANGROBO_PAN_TILT=0
# Drive calibration — tunable on the robot without a rebuild. See
# INTEGRATION_GAPS.md §3 for what these mean and how to re-measure them.
#LANGROBO_LINEAR_VEL_MS=0.20      # commanded forward/back speed, m/s
#LANGROBO_PHYSICAL_VEL_MS=0.20    # speed actually achieved at that command
#LANGROBO_ANGULAR_VEL_RS=5.0      # commanded yaw rate, rad/s
#LANGROBO_STEADY_ANGULAR_VEL=5.0  # yaw rate actually achieved (MEASURE THIS)
