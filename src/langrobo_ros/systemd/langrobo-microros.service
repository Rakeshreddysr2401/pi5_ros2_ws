[Unit]
Description=LangRobo micro-ROS agent (Pi5 <-> ESP32 WiFi UDP bridge)
After=network-online.target langrobo-discovery.service
Wants=network-online.target langrobo-discovery.service

[Service]
Type=exec
User=rakhi24
ExecStart=/home/rakhi24/ros2_ws/scripts/run_microros.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
