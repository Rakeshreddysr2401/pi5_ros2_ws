#!/bin/zsh
# e12b5 -- start Mitra's LLM + VLM server (Gemma 4 12B, llama.cpp) on the Mac Mini.
#
#   e12b5            start (asks for the Mac password once per boot: GPU memory limit)
#   e12b5 stop       stop it
#   e12b5 status     slots, context, memory
#   e12b5 log        follow the server log
#
# Nothing starts at login: after a power-on, run `e12b5` in a terminal (owner, 2026-10-11).
# While it runs, launchd restarts it if it crashes (KeepAlive); `e12b5 stop` ends that.
# Screen off, screen locked, Terminal closed: it keeps serving (launchd owns it; caffeinate -is
# blocks system sleep). Only a power cut/reboot or logging out stops it.
#
# Why each choice (measured 2026-10-11, docs/mac/LLAMA_CACHE_ISSUE.md):
#  - PATCHED llama.cpp b9830 (~/llama.cpp-mitra, scripts/mac_mini/llama_swa_cache.patch):
#    upstream re-reads every prompt under 1024 tokens (Gemma's sliding window) from scratch.
#  - 5 slots: 0-2 agents, 3 photo questions, 4 the voice "is this for me?" check.
#  - -ub 512: the sliding-window cache keeps 1024 + ub tokens, so a request may branch
#    ~450 tokens back and keep the cache (photo_recall needs ~420). -ub 256 halves that.
#  - GPU limit 13 GB (macOS default ~10.7 GB of 16): 5 slots at -ub 512 do not fit the
#    default. Without the raise it falls back to 5 x 12288 at -ub 256 (fits, smaller rewind).
#  - no --swa-full: it would need ~20 GB of cache for 5 slots. Not needed with the patch.
#  - --cache-ram 0: the host-RAM prompt cache thrashed swap on 16 GB (2026-09-30).
set -u
LABEL=com.mitra.llama-server
BIN=$HOME/llama.cpp-mitra/build/bin/llama-server
M=$HOME/llm_models/gemma/12B
PLIST=$HOME/llama.cpp-mitra/$LABEL.plist      # NOT in ~/Library/LaunchAgents: no autostart
LOG=$HOME/Library/Logs/llama-server.log
GPU_MB=13312
DOMAIN=gui/$(id -u)

wait_up() {
  for i in {1..90}; do
    curl -s -m 2 localhost:8080/health | grep -q '"ok"' && { echo "up after $((i * 2)) s"; return 0; }
    sleep 2
  done
  echo "NOT UP after 180 s -- see: e12b5 log"; return 1
}

status() {
  sysctl -n iogpu.wired_limit_mb | awk '{print "GPU limit MB:", ($1 == 0 ? "default (~10900)" : $1)}'
  curl -s -m 3 localhost:8080/props | python3 -c 'import json,sys
p=json.load(sys.stdin); print("slots:", p["total_slots"], " ctx per slot:", p["default_generation_settings"]["n_ctx"])' \
    2>/dev/null || echo "server: not answering on :8080"
  pid=$(pgrep -f "^$BIN") && ps -o rss= -p $pid | awk '{printf "server RAM: %.1f GB\n", $1 / 1048576}'
}

stop() {
  launchctl bootout $DOMAIN/$LABEL 2>/dev/null
  pkill -f '/llama-server -m ' ; pkill -f '^llama-server -m '
  while pgrep -f 'llama-server -m ' >/dev/null; do sleep 1; done
  echo "stopped"
}

case ${1:-start} in
  stop)   stop; exit ;;
  status) status; exit ;;
  log)    exec tail -f $LOG ;;
  start)  ;;
  *)      echo "usage: e12b5 [start|stop|status|log]"; exit 2 ;;
esac

[[ -x $BIN ]] || { echo "missing $BIN -- rebuild: scripts/mac_mini/build_llama_mitra.sh"; exit 1; }

# 1. GPU memory limit (resets at every boot)
if (( $(sysctl -n iogpu.wired_limit_mb) < GPU_MB )); then
  echo "Raising the GPU memory limit to $GPU_MB MB (Mac password):"
  sudo sysctl iogpu.wired_limit_mb=$GPU_MB >/dev/null
fi
if (( $(sysctl -n iogpu.wired_limit_mb) >= GPU_MB )); then
  CTX=81920 UB=512                    # 5 x 16384, full rewind margin
else
  echo "WARNING: GPU limit not raised -- falling back to 5 x 12288, -ub 256 (rewind margin ~250 tokens)"
  CTX=61440 UB=256
fi

# 2. One owner of port 8080: stop any other llama-server and Ollama (it starts its own)
pkill -f '/Applications/Ollama.app' 2>/dev/null
stop >/dev/null

# 3. Run under launchd (restart on crash), from a plist outside LaunchAgents (no autostart)
args=(/usr/bin/caffeinate -is $BIN -m $M/gemma-4-12B-it-Q4_K_M.gguf
      --mmproj $M/mmproj-gemma-4-12B-it-Q8_0.gguf --host 0.0.0.0 --port 8080 -ngl 99
      --parallel 5 --ctx-size $CTX -ub $UB --jinja --flash-attn on --reasoning off
      --cache-ram 0 --metrics)
{
  print '<?xml version="1.0" encoding="UTF-8"?>'
  print '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
  print '<!-- written by e12b5 at every start; edit e12b5, not this file -->'
  print "<plist version=\"1.0\"><dict><key>Label</key><string>$LABEL</string><key>ProgramArguments</key><array>"
  for a in $args; do print "  <string>$a</string>"; done
  print '</array><key>RunAtLoad</key><true/><key>KeepAlive</key><true/>'
  print '<key>ThrottleInterval</key><integer>10</integer><key>ProcessType</key><string>Interactive</string>'
  print "<key>StandardOutPath</key><string>$LOG</string><key>StandardErrorPath</key><string>$LOG</string>"
  print '</dict></plist>'
} > $PLIST
: > $LOG
launchctl bootstrap $DOMAIN $PLIST || exit 1
wait_up || exit 1
grep -qiE 'out ?of ?memory|Insufficient Memory' $LOG && { echo "GPU OUT OF MEMORY -- see: e12b5 log"; exit 1; }
status
